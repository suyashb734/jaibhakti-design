  <body>
    <header>
      <a
        class="jb-brand"
        href="../index.html"
        aria-label="Jai Bhakti design hub"
        ><img src="../assets/brand/temple-mark.svg" alt="" /><span lang="hi"
          >जय भक्ति</span
